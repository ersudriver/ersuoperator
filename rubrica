<!DOCTYPE html>
<html>
  <body>
    <input type="text" id="nome" placeholder="Scrivi un nome...">
    <button onclick="cerca()">Cerca</button>
    <p id="risultato"></p>

    <script>
      function cerca() {
        const nome = document.getElementById('nome').value;
        google.script.run.withSuccessHandler(res => {
          document.getElementById('risultato').innerText = res;
        }).cercaContatto(nome);
      }
    </script>
  </body>
</html>
